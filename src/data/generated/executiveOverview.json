    },
    "InventoryTurns": {
      "Value": 2,
      "Source": "JLI Supply Chain RFP success metric"
    },
    "ForecastBiasBandPct": {
      "Lower": -5,
      "Upper": 5,
      "Source": "Proposed fictional demo threshold",
      "ValidationStatus": "SME Validation Required"
    }
  },
  "metricDefinitions": [
    {
      "MetricID": "METRIC-FORECAST-BIAS",
      "MetricName": "Forecast Bias",
      "Formula": "SUM(ForecastUnits - ActualUnits) / SUM(ActualUnits) * 100",
      "Interpretation": "Positive is over-forecast; negative is under-forecast.",
      "ValidationStatus": "SME Validation Required"
    },
    {
      "MetricID": "METRIC-WAPE",
      "MetricName": "Weighted Absolute Percentage Error",
      "Formula": "SUM(ABS(ForecastUnits - ActualUnits)) / SUM(ActualUnits) * 100",
      "Interpretation": "Lower is better.",
      "ValidationStatus": "SME Validation Required"
    },
    {
      "MetricID": "METRIC-AB-IN-STOCK",
      "MetricName": "A/B SKU In-Stock Rate",
      "Formula": "ABSkuInStockCount / ABSkuCount * 100",
      "Interpretation": "Higher is better.",
      "ValidationStatus": "Prototype definition"
    },
    {
      "MetricID": "METRIC-INVENTORY-TURNS",
      "MetricName": "Inventory Turns",
      "Formula": "Trailing12MonthCOGS / AverageInventoryValue",
      "Interpretation": "Compared with the RFP target of 2.0 or greater.",
      "ValidationStatus": "Prototype definition"
    },
    {
      "MetricID": "METRIC-ETA-STABILITY",
      "MetricName": "ETA Stability",
      "Formula": "ETAStablePOLines / ETAEligiblePOLines * 100",
      "Interpretation": "Share of eligible PO lines whose customer-facing ETA remained within the demo tolerance.",
      "ValidationStatus": "SME Validation Required"
    }
  ],
